{
	"name": "mondrian.pdf",
	"version": "0.1.9",
	"description": "a low-level TypeScript interface to PDF",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/mondrian.git",
		"directory": "packages/mondrian"
	},
	"license": "MPL-2.0",
	"type": "module",
	"exports": {
		"./print": {
			"import": "./dist/print.mjs",
			"types": "./dist/print.d.mts"
		},
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./testing": {
			"import": "./dist/testing.mjs",
			"types": "./dist/testing.d.mts"
		},
		"./vitest": {
			"import": "./dist/vitest.mjs",
			"types": "./dist/vitest.d.mts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"AGENTS.md",
		"dist/*.d.mts",
		"dist/*.d.mts.map",
		"dist/*.mjs",
		"dist/*.mjs.map",
		"src"
	],
	"scripts": {
		"build": "vp pack",
		"cov": "vp test run --coverage",
		"cov:check": "pnpm run cov && node scripts/check-source-coverage.ts",
		"test": "vp test",
		"test:public": "vp test run tests/public --passWithNoTests=false",
		"test:semver": "break-check",
		"test:watch": "vp test watch",
		"check:public-types": "tsc --noEmit -p tests/public/tsconfig.json"
	},
	"dependencies": {
		"@embedpdf/pdfium": "2.15.1",
		"@napi-rs/canvas": "1.0.10",
		"@noble/ciphers": "2.4.0",
		"@noble/hashes": "2.4.0",
		"fflate": "0.8.3",
		"jpeg-js": "0.4.4",
		"lcms-wasm": "1.0.5",
		"pdf-lib": "1.17.1",
		"pngjs": "7.0.0"
	},
	"devDependencies": {
		"@types/pngjs": "6.0.5",
		"break-check": "0.8.1",
		"recoverage": "0.1.19",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"vitest": "^4.1.3 || ^5.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
