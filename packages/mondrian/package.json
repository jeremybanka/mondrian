{
	"name": "mondrian.pdf",
	"version": "0.1.14",
	"description": "a low-level TypeScript interface to PDF",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/mondrian.git",
		"directory": "packages/mondrian"
	},
	"license": "MPL-2.0",
	"type": "module",
	"exports": {
		"./inspect": {
			"import": "./dist/inspect.mjs",
			"types": "./dist/inspect.d.mts"
		},
		"./print": {
			"import": "./dist/print.mjs",
			"types": "./dist/print.d.mts"
		},
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./testing": {
			"import": "./dist/testing.mjs",
			"types": "./dist/testing.d.mts"
		},
		"./vitest": {
			"import": "./dist/vitest.mjs",
			"types": "./dist/vitest.d.mts"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"mondrian": "./dist/mondrian.mjs"
	},
	"files": [
		"AGENTS.md",
		"dist",
		"src"
	],
	"scripts": {
		"build": "vp pack && node scripts/build-guide.ts",
		"check:eslint": "eslint --config app/eslint.config.ts app --max-warnings 0",
		"check:lasertag": "lasertag check \"app/src/**/*.module.css\"",
		"check:public-types": "tsc --noEmit -p tsconfig.public.json",
		"check:tsc": "tsc --noEmit -p app/tsconfig.json",
		"cov": "vp test run --coverage",
		"cov:check": "pnpm run cov && recoverage",
		"dev": "vp dev --config app/vite.config.ts --host 0.0.0.0",
		"preview": "node dist/mondrian.mjs",
		"test": "vp test",
		"test:package": "node scripts/test-package.ts",
		"test:public": "vp test run tests/public --passWithNoTests=false",
		"test:breakage": "breakage",
		"test:watch": "vp test watch"
	},
	"dependencies": {
		"@embedpdf/pdfium": "2.15.1",
		"@napi-rs/canvas": "1.0.13",
		"@noble/ciphers": "2.4.0",
		"@noble/hashes": "2.4.0",
		"fflate": "0.8.3",
		"jpeg-js": "0.4.4",
		"lcms-wasm": "1.0.5",
		"pdf-lib": "1.17.1",
		"pngjs": "7.0.0"
	},
	"devDependencies": {
		"@atom.io/eslint-plugin": "0.1.0",
		"@atom.io/react": "0.1.0",
		"@types/pngjs": "6.0.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.72.0",
		"@typescript-eslint/utils": "8.72.0",
		"@visx/scale": "4.0.0",
		"@visx/shape": "4.0.0",
		"@vitejs/plugin-react": "6.1.2",
		"atom.io": "0.54.0",
		"breakage": "0.8.5",
		"eslint": "10.13.0",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"jiti": "2.7.0",
		"lasertag": "0.8.9",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"recoverage": "0.1.20",
		"treetrunks": "0.1.13",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"vitest": "^4.1.3 || ^5.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
