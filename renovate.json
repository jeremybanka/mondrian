{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"automerge": true,
	"branchConcurrentLimit": 9,
	"internalChecksFilter": "strict",
	"minimumReleaseAge": "1 day",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 9,
	"pruneBranchAfterAutomerge": true,
	"pruneStaleBranches": true,
	"statusCheckWhen": { "minimumReleaseAge": "never" },
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/actions\\/setup\\/action\\.yml$/"],
			"matchStrings": [
				"uses: jdx\\/mise-action@\\S+(?:\\s+#.*)?\\s+      with:\\s+        version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver-coerced"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
			"matchStrings": [
				"renovate-version: (?<currentValue>\\S+)"
			],
			"depNameTemplate": "ghcr.io/renovatebot/renovate",
			"datasourceTemplate": "docker",
			"versioningTemplate": "semver-coerced"
		}
	],
	"packageRules": [
		{
			"description": "Exempt packages authored by Jeremy Banka from release age checks",
			"matchDatasources": ["npm"],
			"matchPackageNames": [
				"break-check",
				"comline",
				"recoverage",
				"takua",
				"treetrunks"
			],
			"minimumReleaseAge": null
		},
		{
			"matchPackageNames": ["jdx/mise"],
			"matchDatasources": ["github-releases"],
			"ignoreUnstable": true
		},
		{
			"groupName": "vite-plus",
			"matchPackageNames": [
				"vite",
				"vitest",
				"vite-plus",
				"@vitejs/*",
				"@vitest/*",
				"@voidzero-dev/vite-plus-core"
			],
			"separateMajorMinor": false,
			"groupSingleUpdates": true,
			"skipArtifactsUpdate": true,
			"postUpgradeTasks": {
				"commands": [
					"node scripts/sync-vite-plus.ts"
				],
				"executionMode": "update",
				"fileFilters": [
					"package.json",
					"packages/*/package.json",
					"pnpm-workspace.yaml",
					"pnpm-lock.yaml"
				],
				"installTools": { "node": {}, "pnpm": {} }
			}
		},
		{
			"description": "Vite Plus selects the bundled Vite and Vitest versions; the post-upgrade task synchronizes their dependencies",
			"matchPackageNames": [
				"vite",
				"vitest",
				"@vitest/*",
				"!@vitest/eslint-plugin",
				"@voidzero-dev/vite-plus-core"
			],
			"enabled": false
		},
		{
			"matchPackageNames": ["vite-plus"],
			"ignoreUnstable": false,
			"respectLatest": false
		},
		{
			"matchManagers": ["github-actions"],
			"dependencyDashboardApproval": true
		},
		{
			"matchPackageNames": [
				"renovatebot/github-action",
				"ghcr.io/renovatebot/renovate"
			],
			"dependencyDashboardApproval": true,
			"groupName": "renovate",
			"minimumReleaseAge": null
		},
		{
			"matchPackageNames": ["@typescript/*"],
			"minimumReleaseAge": null
		}
	]
}
