{
	"name": "mondrian-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run --filter mondrian.pdf --fail-if-no-match build",
		"change": "changeset",
		"check": "vp check --no-fmt",
		"coverage": "vp run --filter mondrian.pdf --fail-if-no-match coverage",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"lint": "vp lint",
		"release": "pnpm build && changeset publish",
		"staged": "vp staged",
		"test": "vp run --filter mondrian.pdf --fail-if-no-match test",
		"workflows": "node scripts/update-workflows.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.2",
		"@changesets/config": "4.0.0",
		"@dprint/json": "0.23.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.39.0",
		"@dprint/toml": "0.8.0",
		"@types/node": "26.5.1",
		"@vitest/coverage-v8": "5.0.0",
		"dprint": "0.57.4",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "0.3.1"
	},
	"engines": {
		"node": "26.8.2",
		"pnpm": "12.4.1"
	},
	"packageManager": "pnpm@12.4.1"
}
