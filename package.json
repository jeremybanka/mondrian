{
	"name": "mondrian-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:eslint": "vp run -r check:eslint",
		"check:fmt": "dprint check",
		"check:lasertag": "vp run -r check:lasertag",
		"check:public-types": "vp run -r check:public-types",
		"check:vp": "vp check --no-fmt && vp run -r check:tsc",
		"cov": "vp run -r cov",
		"cov:check": "vp run -r --no-cache cov:check",
		"fmt": "dprint fmt",
		"mondrian": "node packages/mondrian/dist/mondrian.mjs",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm fmt",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:breakage": "vp run -r --no-cache test:breakage",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"workflows:update": "node scripts/update-workflows.ts",
		"check:unused": "knip",
		"check:unused:production": "knip --production"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.26.0",
		"@dprint/markdown": "0.29.0",
		"@dprint/oxc": "0.49.1",
		"@dprint/toml": "0.10.0",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "catalog:",
		"dprint": "0.64.3",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-yaml": "0.6.0",
		"knip": "6.44.1",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "26.13.0",
		"pnpm": "12.18.0"
	}
}
