{
	"name": "@mondrian/pdf-guide",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build",
		"dev": "pnpm --filter mondrian.pdf build && vp dev --host 0.0.0.0",
		"preview": "vp preview --host 0.0.0.0",
		"fmt": "dprint fmt .",
		"check": "pnpm run \"/^check:.*/\"",
		"check:eslint": "eslint . --max-warnings 0",
		"check:tsc": "tsc --noEmit",
		"check:lasertag": "lasertag check \"src/**/*.module.css\"",
		"test": "vp test run"
	},
	"dependencies": {
		"@visx/scale": "4.0.0",
		"@visx/shape": "4.0.0",
		"atom.io": "0.53.3",
		"mondrian.pdf": "workspace:*",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"treetrunks": "0.1.12"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.71.0",
		"@typescript-eslint/utils": "8.71.0",
		"@vitejs/plugin-react": "6.1.1",
		"eslint": "10.12.0",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"jiti": "2.7.0",
		"lasertag": "0.8.7",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
