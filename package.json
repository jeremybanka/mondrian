{
	"name": "mondrian-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm build && vp check --no-fmt",
		"coverage": "vp run -r coverage",
		"coverage:track": "vp run -r coverage:track",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"lint": "vp lint",
		"release": "pnpm build && changeset publish",
		"release:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm fmt",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:semver": "vp run -r --no-cache test:semver",
		"workflows": "node scripts/update-workflows.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.24.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.40.0",
		"@dprint/toml": "0.8.0",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "4.1.11",
		"dprint": "0.57.4",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.3",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "0.3.3"
	},
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": "26.10.0",
		"pnpm": "12.5.1"
	}
}
