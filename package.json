{
	"name": "mondrian-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"change": "changeset",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:vp": "pnpm run build && vp check --no-fmt",
		"cov": "vp run -r cov",
		"cov:check": "vp run -r --no-cache cov:check",
		"fmt": "dprint fmt",
		"release:publish": "pnpm build && changeset publish",
		"release:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm fmt",
		"staged": "vp staged",
		"test": "vp run -r test",
		"test:semver": "vp run -r --no-cache test:semver",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"workflows:update": "node scripts/update-workflows.ts"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.0",
		"@dprint/markdown": "0.24.0",
		"@dprint/oxc": "0.42.0",
		"@dprint/toml": "0.8.0",
		"@types/node": "26.6.3",
		"@vitest/coverage-v8": "catalog:",
		"dprint": "0.57.4",
		"dprint-plugin-malva": "0.16.0",
		"dprint-plugin-markup": "0.27.5",
		"dprint-plugin-yaml": "0.6.0",
		"typescript": "7.0.2",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "26.10.0",
		"pnpm": "12.6.0"
	}
}
